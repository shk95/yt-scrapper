# Copy to deploy/.env and fill in. Compose reads it automatically, because the
# project directory is the directory of the compose file.
#
#   cp deploy/.env.example deploy/.env && $EDITOR deploy/.env
#
# deploy/.env is git-ignored (`.env.*` in .gitignore, with this example the one
# exception). Every value below that ends in a password or a URL is a
# credential: nothing here belongs in docker-compose.yml, which is why that
# file interpolates all of them.

# --------------------------------------------------------------------------
# Always required.
# --------------------------------------------------------------------------

# The runtime role. DML only — api, worker and watch log in as this.
TUBEDEPTH_DATABASE_URL=postgresql+psycopg://tubedepth_runtime:CHANGE_ME@postgres:5432/fleet

# The migrator role. Used by the `migrate` one-shot alone: it runs alembic,
# which SET ROLEs to tubedepth_owner and issues DDL. Pointing this at the
# runtime URL fails on the first CREATE, which is the boundary working.
TUBEDEPTH_MIGRATOR_DATABASE_URL=postgresql+psycopg://tubedepth_migrator:CHANGE_ME@postgres:5432/fleet

# --------------------------------------------------------------------------
# Optional.
# --------------------------------------------------------------------------

# Where the API is published on the host. The container always listens on 8080.
#TUBEDEPTH_API_PORT=8080

# The image the four services run. `docker compose build` produces it under
# this name; set it to point at one built elsewhere.
#TUBEDEPTH_IMAGE=tubedepth:dev

# Your own watch list, instead of the committed example. One typed directive
# per line; see deploy/watchlist.example.txt for the format and the arithmetic.
#TUBEDEPTH_WATCHLIST_FILE=./watchlist.txt

# The deployment-wide collection caps. Set them here or not at all: they are
# part of the cache fingerprint, and docker-compose.yml gives api, worker and
# watch one shared env block precisely so they cannot end up with different
# values. The defaults below are the code's own.
#TUBEDEPTH_LISTING_LIMIT=100
#TUBEDEPTH_COMMENT_LIMIT=200
#TUBEDEPTH_TRENDING_LIMIT=200

# Only `trending.videos` needs it — the official Data API, and Google's quota
# rather than the per-address budget. Without it that one kind fails as a
# configuration error and nothing else is affected.
#TUBEDEPTH_DATA_API_KEY=

# --------------------------------------------------------------------------
# `--profile local` only: the throwaway PostgreSQL this stack can bring up
# instead of the external fleet one. The two URLs above must name `postgres`
# as the host and carry the two passwords below.
# --------------------------------------------------------------------------

#TUBEDEPTH_LOCAL_SUPERUSER=fleet
#TUBEDEPTH_LOCAL_DATABASE=fleet
# Needed only with `--profile local`; an external-server deployment leaves
# all three commented out. Uncommented-but-empty is refused where it is
# used — the postgres image for the first, the initdb wrapper for the rest.
#TUBEDEPTH_LOCAL_SUPERUSER_PASSWORD=CHANGE_ME
#TUBEDEPTH_LOCAL_MIGRATOR_PASSWORD=CHANGE_ME
#TUBEDEPTH_LOCAL_RUNTIME_PASSWORD=CHANGE_ME
